# App
APP_BASE_URL=http://39.108.58.140
NODE_ENV=production
AUTH_MODE=local
MAX_UPLOAD_MB=200
ALLOW_GENERATE_WITH_MISSING_PRIOR_ART=false
# Session cookies are only marked Secure once the site is served over HTTPS.
COOKIE_SECURE=false

# Set to true for the first deployment only: while no account exists, the first
# account to register becomes the ADMIN. Turn it off afterwards.
BOOTSTRAP_FIRST_ADMIN=true

# Self-hosted PostgreSQL on the same host.
DATABASE_URL=postgresql://oa:change-me@127.0.0.1:5432/oa_agent

# Object storage: Aliyun OSS through its S3-compatible endpoint.
# Buckets created in Chinese mainland regions after 2025-03-20 must be reached
# through a bound custom domain for data API calls; cn-hongkong and
# cn-singapore avoid that requirement.
S3_ENDPOINT=https://s3.oss-cn-hongkong.aliyuncs.com
S3_REGION=cn-hongkong
S3_BUCKET=oa-agent
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# OSS serves only virtual-hosted requests.
S3_FORCE_PATH_STYLE=false
# OSS rejects boto3's aws-chunked Signature V4, so the worker signs with V2.
S3_SIGNATURE_VERSION=s3

# LLM secrets (model names are stored in Model Profiles)
OPENAI_API_KEY=
OPENAI_SECONDARY_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_PROVIDER=deepseek

# Worker
WORKER_ID=worker-ecs-1
WORKER_POLL_MS=1500
WORKER_STALE_MINUTES=20
WORKER_TEMP_DIR=/var/lib/oa-agent/tmp

# Aliyun IMM: Office/PDF conversion. Replaces LibreOffice inside the worker.
# Create the project in the same region as the bucket, then enable IMM.
ALIYUN_IMM_PROJECT=
# Defaults to S3_REGION.
ALIYUN_IMM_REGION=
# Defaults to imm.<region>.aliyuncs.com
ALIYUN_IMM_ENDPOINT=
# Default to S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
ALIYUN_IMM_ACCESS_KEY_ID=
ALIYUN_IMM_ACCESS_KEY_SECRET=
ALIYUN_IMM_POLL_SECONDS=2
ALIYUN_IMM_TIMEOUT_SECONDS=300

# Aliyun OCR: scanned-page recognition. Replaces PaddleOCR.
# The OCR API is not offered per region — only the central endpoint below
# resolves, so it is independent of the bucket region.
ALIYUN_OCR_ENDPOINT=
ALIYUN_OCR_REGION=cn-hangzhou
# advanced (高精版) or general (通用版)
ALIYUN_OCR_MODE=advanced
# Default to S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=

# Runtime
ACTIVE_SKILL_SLUG=cn-patent-oa-response
LLM_CONTEXT_CHAR_LIMIT=180000
MAX_REPAIR_ATTEMPTS=2
PARSER_VERSION=1.0.0
BUILDER_VERSION=1.0.0
APP_GIT_SHA=ecs
